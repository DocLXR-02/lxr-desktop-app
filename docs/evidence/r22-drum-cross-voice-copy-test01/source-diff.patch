+++ b/.github/workflows/r22-drum-copy-validation.yml
@@ -0,0 +1,104 @@
+name: R22 cross-kit Drum copy ARM/host validation
+on:
+  push:
+    branches:
+      - release/r22
+permissions:
+  contents: read
+jobs:
+  r22-voice-copy-validation:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 40
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - name: Record source identity
+        run: |
+          mkdir -p build/r22-voice-copy-evidence
+          git rev-parse HEAD | tee build/r22-voice-copy-evidence/SOURCE_SHA.txt
+          git -c core.whitespace=cr-at-eol diff --check HEAD^ HEAD
+      - name: R22 direct transfer, selector and project round trips
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 tests/r21_voice_copy/run.py 2>&1 | tee build/r22-voice-copy-evidence/r21-host.log
+          python3 tests/r22_drum_copy/run.py 2>&1 | tee build/r22-voice-copy-evidence/r22-host.log
+          python3 tests/bug001/run.py 2>&1 | tee build/r22-voice-copy-evidence/parameter-sweeps.log
+      - name: Compile and exercise standalone capture state machine
+        shell: bash
+        run: |
+          set -euo pipefail
+          cc -std=c11 -O2 -Wall -Wextra -Werror -fsanitize=undefined,bounds -fno-sanitize-recover=all \
+            -ICore/Inc Core/Src/Soundengine/Sequencer/automationCapture.c tests/bug008/host.c \
+            -o build/r22-voice-copy-evidence/bug008-host
+          build/r22-voice-copy-evidence/bug008-host 2>&1 | tee build/r22-voice-copy-evidence/bug008-host.log
+      - name: Playback numerical regression (exhaustive fixed-8 equivalence)
+        shell: bash
+        run: |
+          set -euo pipefail
+          cc -std=c11 -O2 -Wall -Wextra -Werror -fsanitize=undefined,bounds -fno-sanitize-recover=all \
+            -ICore/Inc Core/Src/Soundengine/Sequencer/automationPlayback.c tests/automation_playback/host.c \
+            -o build/r22-voice-copy-evidence/playback-host
+          build/r22-voice-copy-evidence/playback-host 2>&1 | tee build/r22-voice-copy-evidence/playback-host.log
+      - name: R20 host conflict and LCD timing regression
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 tests/r20_ui/run.py 2>&1 | tee build/r22-voice-copy-evidence/r20-ui-host.log
+          python3 tests/r20_ui/integration/probe.py . build/r20-ui-host 2>&1 | tee build/r22-voice-copy-evidence/r20-ui-integration.log
+      - name: Verify adaptive source and extra menu choices removed
+        shell: bash
+        run: |
+          set -euo pipefail
+          ! grep -R -E 'PAR_AUTO_RES|PAR_AUTO_ALG|MENU_AUTO_RES|MENU_AUTO_ALG|SEQ_SET_AUTO_RES|SEQ_SET_AUTO_ALG|chooseDivisions|seq_playbackAdaptive|seq_playbackResolution|autoAlgNames|autoResNames' \
+            Core/Inc Core/Src || exit 1
+          grep -q 'lane->divisions = 8u;' Core/Src/Soundengine/Sequencer/automationPlayback.c
+          grep -q 'PAR_AUTOM_TRACK.*PAR_REC_MODE.*PAR_NONE.*PAR_NONE' Core/Inc/menu/menuPages.h
+          grep -q 'PAR_REC_MODE - PAR_BEGINNING_OF_GLOBALS' Core/Src/Preset/presetManager.c
+      - name: Existing globals and project storage regressions
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 tests/project_storage/run.py 2>&1 | tee build/r22-voice-copy-evidence/project-storage.log
+          python3 tests/project_transaction/run.py 2>&1 | tee build/r22-voice-copy-evidence/project-transaction.log
+      - name: Reuse R19 regressions for USB-MIDI, Delay and Compressor
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 tests/r18_delay_mono/run.py build/f8-delay 2>&1 | tee build/r22-voice-copy-evidence/delay.log
+          python3 tests/r18_usb_midi/run.py build/f8-usb 2>&1 | tee build/r22-voice-copy-evidence/usb.log
+          python3 tests/r18_compressor_mono/run.py build/f8-compressor 2>&1 | tee build/r22-voice-copy-evidence/compressor.log
+          python3 tests/fx_clip_r18/compare.py 2>&1 | tee build/r22-voice-copy-evidence/clp-compare.log
+      - name: Install R19-matched ARM GNU Toolchain 14.3.rel1
+        shell: bash
+        run: |
+          set -euo pipefail
+          URL=https://armkeil.blob.core.windows.net/developer/Files/downloads/gnu/14.3.rel1/binrel/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi.tar.xz
+          curl -fL --retry 3 "$URL" -o "$RUNNER_TEMP/arm-toolchain.tar.xz"
+          echo "8f6903f8ceb084d9227b9ef991490413014d991874a1e34074443c2a72b14dbd  $RUNNER_TEMP/arm-toolchain.tar.xz" | sha256sum --check
+          tar -xJf "$RUNNER_TEMP/arm-toolchain.tar.xz" -C "$RUNNER_TEMP"
+          echo "$RUNNER_TEMP/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/bin" >> "$GITHUB_PATH"
+      - name: Build candidate firmware (validation only)
+        shell: bash
+        run: |
+          set -euo pipefail
+          cmake --preset release 2>&1 | tee build/r22-voice-copy-evidence/configure.log
+          cmake --build --preset release --parallel 2 2>&1 | tee build/r22-voice-copy-evidence/build.log
+          arm-none-eabi-size -A build/release/LXR_V2_STM32F765.elf 2>&1 | tee build/r22-voice-copy-evidence/sections.log
+          arm-none-eabi-gcc --version > build/r22-voice-copy-evidence/COMPILER.txt
+          cp build/release/LXR_V2_STM32F765.map build/r22-voice-copy-evidence/
+          cp build/release/LXR_V2_STM32F765.elf build/r22-voice-copy-evidence/
+          cp build/release/LXR_V2_V1.7.img build/r22-voice-copy-evidence/LXR_V2_R22_TEST01.img
+          (cd build/r22-voice-copy-evidence && sha256sum LXR_V2_R22_TEST01.img LXR_V2_STM32F765.elf LXR_V2_STM32F765.map > OUTPUT_SHA256SUMS.txt)
+          echo "R22 VOICE TRANSFER TEST CANDIDATE; OWNER DEVICE TEST PENDING; R18/R19/R20/R21/FIX8 PROTECTED; NO STABLE RELEASE." > build/r22-voice-copy-evidence/NOT_FOR_FLASHING.txt
+      - name: Validate R22 image, ZIP and static resources
+        run: python3 tests/r22_drum_copy/validate_arm.py
+      - name: Preserve evidence also on failure
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: r22-voice-copy-build-evidence
+          path: build/r22-voice-copy-evidence/
+          retention-days: 30
+          if-no-files-found: error
